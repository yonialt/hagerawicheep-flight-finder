# ---- Flight providers (all optional — demo provider is used when unset) ----
# Duffel: https://duffel.com (test_* keys hit the sandbox automatically)
DUFFEL_API_KEY=

# Amadeus Self-Service: https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Set to "test" while using test credentials
AMADEUS_HOSTNAME=

# Kiwi.com Tequila (backup international): https://tequila.kiwi.com
KIWI_API_KEY=

# ---- Database (optional — in-memory fallback when unset) ----
# e.g. postgres://user:pass@host:5432/hagerawi
DATABASE_URL=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
